# Copy to .env.local and fill in. Never commit .env.local.

# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ---
# Used for embeddings and answer generation.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Auth.js (https://authjs.dev) ---
# Generate with: npx auth secret
AUTH_SECRET=
# GitHub OAuth app. Callback URL must match the dev port exactly:
#   local:      http://localhost:3003/api/auth/callback/github
#   production: https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Neon Postgres (https://neon.tech) ---
# Pooled connection (host contains "-pooler") — used by the app at runtime.
DATABASE_URL=
# Direct connection (same string without "-pooler") — used by migrations,
# which need a real session rather than a pooled one.
DATABASE_URL_UNPOOLED=

# --- Upstash Redis (https://upstash.com) ---
# Take the REST credentials, not the redis:// TCP string: the TCP protocol
# does not work from serverless runtimes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Inngest (https://inngest.com) ---
# Routes events to the local dev server and skips request signing. Set to 1
# locally; leave unset in production, or the app will look for a dev server
# that is not there.
INNGEST_DEV=1
# Only needed in production. With a signing key present and INNGEST_DEV unset,
# the SDK runs in cloud mode and rejects the local dev server with a 401.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
